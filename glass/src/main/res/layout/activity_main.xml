<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Status Layout (Recording / Sending / Thinking) -->
    <RelativeLayout
        android:id="@+id/status_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:contentDescription="Status Icon"
            android:src="@android:drawable/sym_def_app_icon" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/status_icon"
            android:layout_alignTop="@id/status_icon"
            android:layout_marginLeft="20dp"
            android:text="Recording..."
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:fontFamily="sans-serif-light" />

    </RelativeLayout>

    <!-- Response Layout (Scrollable Text + Custom Scrollbar) -->
    <LinearLayout
        android:id="@+id/response_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <!-- Left Sidebar (Icon + Custom Scrollbar) -->
        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/response_provider_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Provider Icon"
                android:src="@android:drawable/sym_def_app_icon" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <!-- Custom Scrollbar Track -->
            <FrameLayout
                android:id="@+id/scrollbar_track"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#33ffffff">

                <!-- Custom Scrollbar Thumb -->
                <View
                    android:id="@+id/scrollbar_thumb"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:background="@android:color/white" />

            </FrameLayout>

        </LinearLayout>

        <!-- Right Content Area (Scrollable Text) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="20dp">

            <com.custom.gin.ObservableScrollView
                android:id="@+id/response_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/response_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="sans-serif-light"
                    android:text="" />

            </com.custom.gin.ObservableScrollView>

        </FrameLayout>

    </LinearLayout>

    <!-- Fullscreen Dimming Overlay Timer -->
    <TextView
        android:id="@+id/overlay_timer_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="#B3000000"
        android:textColor="@android:color/white"
        android:textSize="80sp"
        android:fontFamily="sans-serif-light"
        android:visibility="gone" />

</RelativeLayout>
