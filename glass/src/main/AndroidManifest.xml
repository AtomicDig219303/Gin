<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission required to define voice triggers on Google Glass -->
    <uses-permission android:name="com.google.android.glass.permission.DEVELOPMENT" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_aimodel_generic_64x64"
        android:label="@string/app_name"
        android:theme="@style/GlassTheme">

        <!-- Unified Main Activity -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:enabled="true"
            android:exported="true" />

        <!-- Voice Query Activity (Trampoline) -->
        <activity
            android:name=".VoiceActivity"
            android:icon="@drawable/ic_microphone_on_50"
            android:label="Voice Assistant"
            android:theme="@android:style/Theme.NoDisplay"
            android:enabled="true"
            android:exported="true">
            
            <intent-filter>
                <action android:name="com.google.android.glass.action.VOICE_TRIGGER" />
            </intent-filter>

            <meta-data
                android:name="com.google.android.glass.VoiceTrigger"
                android:resource="@xml/voice_trigger_voice" />
        </activity>

        <!-- Camera Capture Activity (Trampoline) -->
        <activity
            android:name=".CameraActivity"
            android:icon="@drawable/ic_camera_50"
            android:label="Visual Assistant"
            android:theme="@android:style/Theme.NoDisplay"
            android:enabled="true"
            android:exported="true">
            
            <intent-filter>
                <action android:name="com.google.android.glass.action.VOICE_TRIGGER" />
            </intent-filter>

            <meta-data
                android:name="com.google.android.glass.VoiceTrigger"
                android:resource="@xml/voice_trigger_camera" />
        </activity>

        <!-- Settings Activity (Preset & Mode Configuration) -->
        <activity
            android:name=".SettingsActivity"
            android:icon="@drawable/ic_gear_50"
            android:label="Gin Settings"
            android:enabled="true"
            android:exported="true">
            
            <intent-filter>
                <action android:name="com.google.android.glass.action.VOICE_TRIGGER" />
            </intent-filter>

            <meta-data
                android:name="com.google.android.glass.VoiceTrigger"
                android:resource="@xml/voice_trigger_settings" />
        </activity>

    </application>

</manifest>
